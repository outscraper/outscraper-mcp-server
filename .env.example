OUTSCRAPER_API_KEY=your_outscraper_api_key_here

# Optional: API origin for the same organization as the key.
# The bridge appends /mcp/<API_KEY>; this keyed endpoint must be deployed.
# Do not include /mcp, credentials, or query parameters in this value.
OUTSCRAPER_API_BASE_URL=https://api.outscraper.com

# Optional: hosted mode.
# When true, HTTP requests can provide the API key in Authorization: Bearer ...,
# X-API-KEY / X-OUTSCRAPER-API-KEY, or the /v1/mcp/<api-key> URL path.
CLOUD_SERVICE=false

# Optional: switch from stdio to stateless Streamable HTTP.
HTTP_STREAMABLE_SERVER=false

# Optional: stateful Streamable HTTP with session management.
# SSE_LOCAL is a deprecated alias, not a legacy SSE endpoint.
SSE_LOCAL=false
HTTP_STATEFUL_SERVER=false

HOST=localhost
PORT=3000
